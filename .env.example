# ─────────────────────────────────────────
#  SHAHKAR .env — Copy to .env and fill in
#  NEVER commit .env to GitHub
# ─────────────────────────────────────────

# Binance API
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Mode: paper = fake money | live = real money
MODE=paper

# Capital settings
CAPITAL_PER_TRADE=5.0
MAX_OPEN_TRADES=3
MIN_SCORE=85
DAILY_LOSS_LIMIT=30.0

# ─────────────────────────────────────────
#  News AI — pick ONE (Groq is FREE)
# ─────────────────────────────────────────

# OPTION 1: Groq (FREE) — recommended
# Get free key: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# OPTION 2: Anthropic Claude (Paid ~$1-2/month)
# Get key: https://console.anthropic.com
# ANTHROPIC_API_KEY=your_anthropic_key_here

# ── Whale Tracking APIs (Optional but powerful) ──────────────
# Etherscan — Free: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_key_here

# BSCScan — Free: https://bscscan.com/myapikey  
BSCSCAN_API_KEY=your_bscscan_key_here

# CoinGlass — Free tier: https://coinglass.com/pricing
COINGLASS_API_KEY=your_coinglass_key_here

# ── Institutional Intelligence (Optional) ────────────────────
# Glassnode Free: https://glassnode.com/
GLASSNODE_API_KEY=your_glassnode_key_here
